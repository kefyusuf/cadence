{
  "name": "cadence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Recurring schedule engine and team board: wall-clock correct recurrence, event-driven state, hexagonal core.",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./domain": {
      "types": "./dist/domain/index.d.ts",
      "default": "./dist/domain/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "verify:package": "node scripts/verify-package.mjs",
    "lint": "eslint .",
    "lint:deps": "depcruise src test scripts --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.12.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3.2.0"
  }
}
